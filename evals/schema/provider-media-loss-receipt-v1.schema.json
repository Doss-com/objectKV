{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Doss-com/objectKV/evals/schema/provider-media-loss-receipt-v1.schema.json",
  "title": "objectKV provider media-loss receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "provider",
    "run_id",
    "source",
    "destination",
    "media_loss",
    "object_closure",
    "restore",
    "correctness_anomalies",
    "media_loss_verified",
    "negative_control",
    "gates",
    "timings",
    "scope"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "foundationdb_objectkv_media_loss_r0" },
    "provider": {
      "const": "foundationdb-7.4.6@e77b64d4c5d01d240931c08c5384a834cae27337"
    },
    "run_id": { "type": "string", "minLength": 1 },
    "source": { "$ref": "#/$defs/providerIdentity" },
    "destination": { "$ref": "#/$defs/providerIdentity" },
    "media_loss": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed_at",
        "source_instance_absent",
        "source_boot_disk_absent",
        "source_data_disk_absent",
        "removed_before_restore"
      ],
      "properties": {
        "observed_at": { "type": "string", "format": "date-time" },
        "source_instance_absent": { "type": "boolean" },
        "source_boot_disk_absent": { "type": "boolean" },
        "source_data_disk_absent": { "type": "boolean" },
        "removed_before_restore": { "type": "boolean" }
      }
    },
    "object_closure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_uri",
        "manifest_generation",
        "manifest_sha256",
        "manifest_bytes",
        "closure_uri",
        "closure_generation",
        "closure_sha256",
        "closure_bytes",
        "state_digest",
        "through_provider_stamp",
        "record_count"
      ],
      "properties": {
        "manifest_uri": { "type": "string", "pattern": "^gs://" },
        "manifest_generation": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "manifest_sha256": { "$ref": "#/$defs/sha256" },
        "manifest_bytes": { "type": "integer", "minimum": 1 },
        "closure_uri": { "type": "string", "pattern": "^gs://" },
        "closure_generation": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "closure_sha256": { "$ref": "#/$defs/sha256" },
        "closure_bytes": { "type": "integer", "minimum": 1 },
        "state_digest": { "$ref": "#/$defs/sha256" },
        "through_provider_stamp": { "type": "string", "minLength": 20 },
        "record_count": { "type": "integer", "minimum": 1 }
      }
    },
    "restore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "started_at",
        "finished_at",
        "destination_empty_before_restore",
        "named_object_hashes_match",
        "restored_chunks",
        "replayed_chunks",
        "restored_record_count",
        "restored_state_digest",
        "activated_after_ready",
        "fresh_commit_succeeded",
        "source_provider_inputs"
      ],
      "properties": {
        "started_at": { "type": "string", "format": "date-time" },
        "finished_at": { "type": "string", "format": "date-time" },
        "destination_empty_before_restore": { "type": "boolean" },
        "named_object_hashes_match": { "type": "boolean" },
        "restored_chunks": { "type": "integer", "minimum": 0 },
        "replayed_chunks": { "type": "integer", "minimum": 0 },
        "restored_record_count": { "type": "integer", "minimum": 0 },
        "restored_state_digest": { "$ref": "#/$defs/sha256" },
        "activated_after_ready": { "type": "boolean" },
        "fresh_commit_succeeded": { "type": "boolean" },
        "source_provider_inputs": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "correctness_anomalies": { "type": "integer", "minimum": 0 },
    "media_loss_verified": { "type": "boolean" },
    "negative_control": {
      "oneOf": [
        { "type": "null" },
        { "const": "restore_with_hidden_source_media" }
      ]
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/gate" }
    },
    "timings": {
      "type": "array",
      "items": { "$ref": "#/$defs/timing" }
    },
    "scope": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "providerIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cluster_id",
        "cluster_file_sha256",
        "instance_name",
        "instance_id",
        "boot_disk_name",
        "boot_disk_id",
        "data_disk_name",
        "data_disk_id"
      ],
      "properties": {
        "cluster_id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
        "cluster_file_sha256": { "$ref": "#/$defs/sha256" },
        "instance_name": { "type": "string", "minLength": 1 },
        "instance_id": { "type": "string", "minLength": 1 },
        "boot_disk_name": { "type": "string", "minLength": 1 },
        "boot_disk_id": { "type": "string", "minLength": 1 },
        "data_disk_name": { "type": "string", "minLength": 1 },
        "data_disk_id": { "type": "string", "minLength": 1 }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "passed", "detail"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "passed": { "type": "boolean" },
        "detail": { "type": "string", "minLength": 1 }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "duration_ns"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "duration_ns": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
