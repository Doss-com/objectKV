{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Doss-com/objectKV/evals/schema/t27-execution-plan-v1.schema.json",
  "title": "objectKV T27 immutable execution plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile",
    "fixture",
    "execution",
    "expected",
    "positions",
    "plan_sha256"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "profile": { "enum": ["preflight64_mib", "admission1_gib"] },
    "fixture": { "$ref": "fixture-placement-locator-v1.schema.json" },
    "execution": { "$ref": "#/$defs/execution" },
    "expected": { "$ref": "#/$defs/expected" },
    "positions": {
      "type": "array",
      "minItems": 4,
      "maxItems": 540,
      "items": { "$ref": "#/$defs/position" }
    },
    "plan_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_source_sha256",
        "runtime_executable_sha256",
        "runtime_cargo_lock_sha256",
        "machine_receipt_sha256",
        "machine_instance_id",
        "infrastructure_lease_expires_epoch",
        "linux_boot_id",
        "scratch_root",
        "scratch_mount_point",
        "scratch_mount_source",
        "scratch_filesystem_type",
        "scratch_major_minor",
        "scratch_device_number",
        "scratch_filesystem_uuid",
        "scratch_block_device",
        "host_lease_path"
      ],
      "properties": {
        "runtime_source_sha256": { "$ref": "#/$defs/sha256" },
        "runtime_executable_sha256": { "$ref": "#/$defs/sha256" },
        "runtime_cargo_lock_sha256": { "$ref": "#/$defs/sha256" },
        "machine_receipt_sha256": { "$ref": "#/$defs/sha256" },
        "machine_instance_id": { "type": "string", "minLength": 1 },
        "infrastructure_lease_expires_epoch": { "type": "integer", "minimum": 1 },
        "linux_boot_id": { "type": "string", "format": "uuid" },
        "scratch_root": { "type": "string", "pattern": "^/" },
        "scratch_mount_point": { "type": "string", "pattern": "^/" },
        "scratch_mount_source": { "type": "string", "minLength": 1 },
        "scratch_filesystem_type": { "type": "string", "minLength": 1 },
        "scratch_major_minor": { "type": "string", "pattern": "^[0-9]+:[0-9]+$" },
        "scratch_device_number": { "type": "integer", "minimum": 1 },
        "scratch_filesystem_uuid": { "type": "string", "minLength": 1 },
        "scratch_block_device": { "type": "string", "pattern": "^/" },
        "host_lease_path": { "type": "string", "pattern": "^/" }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tail_sha256",
        "resident_logical_sha256",
        "trace_sha256_by_stratum"
      ],
      "properties": {
        "tail_sha256": { "$ref": "#/$defs/sha256" },
        "resident_logical_sha256": { "$ref": "#/$defs/sha256" },
        "trace_sha256_by_stratum": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 27,
          "propertyNames": { "pattern": "^c[0-9]{2}-z[0-9]{2}-s[0-9]+$" },
          "additionalProperties": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal",
        "stratum_id",
        "block",
        "position_in_block",
        "subject",
        "trace_seed",
        "access_pattern",
        "block_cache_bytes",
        "max_local_bytes",
        "warmup_operations",
        "measured_operations",
        "concurrent_clients",
        "direct_reads",
        "treatment_sha256",
        "expected_engine_options_sha256"
      ],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 0, "maximum": 539 },
        "stratum_id": { "type": "string", "pattern": "^c[0-9]{2}-z[0-9]{2}-s[0-9]+$" },
        "block": { "type": "integer", "minimum": 0, "maximum": 4 },
        "position_in_block": { "type": "integer", "minimum": 0, "maximum": 3 },
        "subject": { "enum": ["native_snapshot", "direct_owned_rocksdb"] },
        "trace_seed": { "enum": [1103, 2207, 3301] },
        "access_pattern": { "enum": ["zipf0_8", "zipf1_4", "zipf2_0"] },
        "block_cache_bytes": { "type": "integer", "minimum": 1 },
        "max_local_bytes": { "type": "integer", "minimum": 1 },
        "warmup_operations": { "type": "integer", "minimum": 1 },
        "measured_operations": { "type": "integer", "minimum": 1 },
        "concurrent_clients": { "type": "integer", "minimum": 1 },
        "direct_reads": { "const": true },
        "treatment_sha256": { "$ref": "#/$defs/sha256" },
        "expected_engine_options_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
