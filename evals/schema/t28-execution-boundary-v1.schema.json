{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://objectkv.dev/evals/schema/t28-execution-boundary-v1.schema.json",
  "title": "objectKV RFC-0046 T28 execution boundary v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "plan_sha256", "placement_envelope_sha256", "fixture_id",
    "descriptor_generation", "read_version", "cache_state", "subject",
    "operation_ordinal", "provider", "project", "bucket", "region",
    "principal_email", "principal_unique_id", "credential_source",
    "iam_receipt_sha256", "reader_role_bindings", "token_expires_unix_nanos",
    "denied_write_probe_error_class", "denied_write_probe_object_absent",
    "index_key", "index_sha256", "data_key", "requested_range",
    "logical_data_requests", "provider_attempts", "full_data_requests",
    "list_requests", "put_requests", "delete_requests", "machine_id", "boot_id",
    "process_id", "process_start_ticks", "process_started_unix_nanos",
    "process_finished_unix_nanos", "previous_process_id",
    "previous_process_start_ticks", "previous_process_finished_unix_nanos",
    "process_local_state_reused", "hidden_local_fixture_path", "boundary_sha256"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "plan_sha256": { "$ref": "#/$defs/sha256" },
    "placement_envelope_sha256": { "$ref": "#/$defs/sha256" },
    "fixture_id": { "$ref": "#/$defs/sha256" },
    "descriptor_generation": { "type": "string", "pattern": "^[0-9]+$" },
    "read_version": { "type": "integer", "minimum": 1 },
    "cache_state": { "enum": ["empty_reader", "metadata_warm_data_cold"] },
    "subject": { "enum": ["candidate", "raw_range_control"] },
    "operation_ordinal": { "type": "integer", "minimum": 0 },
    "provider": { "const": "gcs" },
    "project": { "type": "string", "minLength": 1 },
    "bucket": { "type": "string", "minLength": 1 },
    "region": { "type": "string", "minLength": 1 },
    "principal_email": { "type": "string", "minLength": 1 },
    "principal_unique_id": { "type": "string", "minLength": 1 },
    "credential_source": { "const": "gce_metadata_server" },
    "iam_receipt_sha256": { "$ref": "#/$defs/sha256" },
    "reader_role_bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "const": "roles/storage.objectViewer" }
    },
    "token_expires_unix_nanos": { "type": "integer", "minimum": 1 },
    "denied_write_probe_error_class": { "const": "permission_denied" },
    "denied_write_probe_object_absent": { "const": true },
    "index_key": { "type": "string", "minLength": 1 },
    "index_sha256": { "$ref": "#/$defs/sha256" },
    "data_key": { "type": "string", "minLength": 1 },
    "requested_range": { "$ref": "#/$defs/range" },
    "logical_data_requests": { "const": 1 },
    "provider_attempts": { "const": 1 },
    "full_data_requests": { "const": 0 },
    "list_requests": { "const": 0 },
    "put_requests": { "const": 0 },
    "delete_requests": { "const": 0 },
    "machine_id": { "type": "string", "minLength": 1 },
    "boot_id": { "type": "string", "minLength": 1 },
    "process_id": { "type": "integer", "minimum": 1 },
    "process_start_ticks": { "type": "integer", "minimum": 1 },
    "process_started_unix_nanos": { "type": "integer", "minimum": 1 },
    "process_finished_unix_nanos": { "type": "integer", "minimum": 1 },
    "previous_process_id": { "type": "integer", "minimum": 1 },
    "previous_process_start_ticks": { "type": "integer", "minimum": 1 },
    "previous_process_finished_unix_nanos": { "type": "integer", "minimum": 1 },
    "process_local_state_reused": { "const": false },
    "hidden_local_fixture_path": { "type": "null" },
    "boundary_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
