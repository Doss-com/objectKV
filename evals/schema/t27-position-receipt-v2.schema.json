{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Doss-com/objectKV/evals/schema/t27-position-receipt-v2.schema.json",
  "title": "objectKV T27 fresh-process position receipt v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "controller_id",
    "lease_id",
    "worker_id",
    "wrapper_process_id",
    "measured_worker_process_id",
    "measured_worker_linux_boot_id",
    "measured_worker_start_ticks",
    "plan_sha256",
    "execution",
    "position",
    "fixture_envelope_sha256",
    "fixture_id",
    "image_provider",
    "runtime_resident_provider",
    "runtime_serving_image_provider",
    "started_at",
    "finished_at",
    "tail_sha256",
    "resident_logical_sha256",
    "report_semantic_sha256",
    "trace_sha256",
    "observed_subject",
    "observed_treatment_sha256",
    "effective_engine_options_sha256",
    "engine_topology",
    "database_count",
    "block_cache_count",
    "implicit_block_cache_count",
    "column_family_count",
    "metadata_cache_disabled",
    "direct_reads",
    "block_cache_capacity_bytes",
    "block_cache_usage_bytes",
    "block_cache_misses",
    "resident_image_local_bytes",
    "operations_per_second",
    "latency_ns_p99",
    "cpu_nanoseconds_per_read",
    "physical_read_bytes",
    "read_amplification_ratio",
    "flush_write_bytes",
    "compaction_read_bytes",
    "compaction_write_bytes",
    "correctness_failures",
    "object_requests",
    "scratch_was_empty",
    "process_cpu_supported",
    "linux_proc_supported",
    "raw_report_sha256",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "controller_id": { "type": "string", "format": "uuid" },
    "lease_id": { "type": "string", "format": "uuid" },
    "worker_id": { "type": "string", "format": "uuid" },
    "wrapper_process_id": { "type": "integer", "minimum": 1 },
    "measured_worker_process_id": { "type": "integer", "minimum": 1 },
    "measured_worker_linux_boot_id": { "type": "string", "format": "uuid" },
    "measured_worker_start_ticks": { "type": "integer", "minimum": 1 },
    "plan_sha256": { "$ref": "#/$defs/sha256" },
    "execution": { "$ref": "t27-execution-plan-v1.schema.json#/$defs/execution" },
    "position": { "$ref": "t27-execution-plan-v1.schema.json#/$defs/position" },
    "fixture_envelope_sha256": { "$ref": "#/$defs/sha256" },
    "fixture_id": { "$ref": "#/$defs/sha256" },
    "image_provider": { "type": "string", "minLength": 1 },
    "runtime_resident_provider": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "runtime_serving_image_provider": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "tail_sha256": { "$ref": "#/$defs/sha256" },
    "resident_logical_sha256": { "$ref": "#/$defs/sha256" },
    "report_semantic_sha256": { "$ref": "#/$defs/sha256" },
    "trace_sha256": { "$ref": "#/$defs/sha256" },
    "observed_subject": { "enum": ["native_snapshot", "direct_owned_rocksdb"] },
    "observed_treatment_sha256": { "$ref": "#/$defs/sha256" },
    "effective_engine_options_sha256": { "$ref": "#/$defs/sha256" },
    "engine_topology": {
      "enum": ["native-resident:1db:1cache:3cf", "direct-owned:1db:1cache:1cf"]
    },
    "database_count": { "const": 1 },
    "block_cache_count": { "const": 1 },
    "implicit_block_cache_count": { "const": 0 },
    "column_family_count": { "enum": [1, 3] },
    "metadata_cache_disabled": { "type": "boolean" },
    "direct_reads": { "const": true },
    "block_cache_capacity_bytes": { "type": "integer", "minimum": 1 },
    "block_cache_usage_bytes": { "type": "integer", "minimum": 0 },
    "block_cache_misses": { "type": "integer", "minimum": 0 },
    "resident_image_local_bytes": { "type": "integer", "minimum": 1 },
    "operations_per_second": { "type": "number", "exclusiveMinimum": 0 },
    "latency_ns_p99": { "type": "integer", "minimum": 1 },
    "cpu_nanoseconds_per_read": { "type": "number", "exclusiveMinimum": 0 },
    "physical_read_bytes": { "type": "integer", "minimum": 0 },
    "read_amplification_ratio": { "type": "number", "minimum": 0 },
    "flush_write_bytes": { "const": 0 },
    "compaction_read_bytes": { "const": 0 },
    "compaction_write_bytes": { "const": 0 },
    "correctness_failures": { "const": 0 },
    "object_requests": { "const": 0 },
    "scratch_was_empty": { "const": true },
    "process_cpu_supported": { "const": true },
    "linux_proc_supported": { "const": true },
    "raw_report_sha256": { "$ref": "#/$defs/sha256" },
    "receipt_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
