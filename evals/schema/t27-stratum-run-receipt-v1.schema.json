{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Doss-com/objectKV/evals/schema/t27-stratum-run-receipt-v1.schema.json",
  "title": "objectKV T27 resumable stratum-run receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "controller_id",
    "lease_id",
    "lease_acquired_at",
    "lease_released_at",
    "plan_sha256",
    "workload_sha256",
    "execution_sha256",
    "runtime_source_sha256",
    "runtime_executable_sha256",
    "runtime_cargo_lock_sha256",
    "stratum_id",
    "started_at",
    "finished_at",
    "position_ordinals",
    "position_receipt_sha256s",
    "comparisons",
    "telemetry_run_id",
    "telemetry_endpoint_sha256",
    "telemetry_required_signals",
    "telemetry_emitted_positions",
    "telemetry_metrics_flush_succeeded",
    "telemetry_traces_flush_succeeded",
    "telemetry_logs_flush_succeeded",
    "telemetry_metrics_shutdown_succeeded",
    "telemetry_traces_shutdown_succeeded",
    "telemetry_logs_shutdown_succeeded",
    "passed",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "controller_id": { "type": "string", "format": "uuid" },
    "lease_id": { "type": "string", "format": "uuid" },
    "lease_acquired_at": { "type": "string", "format": "date-time" },
    "lease_released_at": { "type": "string", "format": "date-time" },
    "plan_sha256": { "$ref": "#/$defs/sha256" },
    "workload_sha256": { "$ref": "#/$defs/sha256" },
    "execution_sha256": { "$ref": "#/$defs/sha256" },
    "runtime_source_sha256": { "$ref": "#/$defs/sha256" },
    "runtime_executable_sha256": { "$ref": "#/$defs/sha256" },
    "runtime_cargo_lock_sha256": { "$ref": "#/$defs/sha256" },
    "stratum_id": { "type": "string", "pattern": "^c[0-9]{2}-z[0-9]{2}-s[0-9]+$" },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "position_ordinals": {
      "type": "array",
      "minItems": 4,
      "maxItems": 20,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 0, "maximum": 539 }
    },
    "position_receipt_sha256s": {
      "type": "array",
      "minItems": 4,
      "maxItems": 20,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/sha256" }
    },
    "comparisons": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/comparison" }
    },
    "telemetry_run_id": { "type": "string", "format": "uuid" },
    "telemetry_endpoint_sha256": { "$ref": "#/$defs/sha256" },
    "telemetry_required_signals": { "const": ["logs", "metrics", "traces"] },
    "telemetry_emitted_positions": { "type": "integer", "minimum": 4, "maximum": 20 },
    "telemetry_metrics_flush_succeeded": { "type": "boolean" },
    "telemetry_traces_flush_succeeded": { "type": "boolean" },
    "telemetry_logs_flush_succeeded": { "type": "boolean" },
    "telemetry_metrics_shutdown_succeeded": { "type": "boolean" },
    "telemetry_traces_shutdown_succeeded": { "type": "boolean" },
    "telemetry_logs_shutdown_succeeded": { "type": "boolean" },
    "passed": { "type": "boolean" },
    "receipt_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stratum_id",
        "order",
        "sample_pairs",
        "native_throughput_ratio",
        "native_p99_ratio",
        "native_cpu_per_read_ratio",
        "native_block_cache_misses_per_read",
        "control_block_cache_misses_per_read",
        "native_physical_bytes_per_read",
        "control_physical_bytes_per_read",
        "native_physical_bytes_per_read_ratio",
        "native_read_amplification_ratio",
        "pressure_passed",
        "passed"
      ],
      "properties": {
        "stratum_id": { "type": "string", "pattern": "^c[0-9]{2}-z[0-9]{2}-s[0-9]+$" },
        "order": { "enum": ["ab", "ba"] },
        "sample_pairs": { "type": "integer", "minimum": 1, "maximum": 5 },
        "native_throughput_ratio": { "type": "number", "minimum": 0 },
        "native_p99_ratio": { "type": "number", "minimum": 0 },
        "native_cpu_per_read_ratio": { "type": "number", "minimum": 0 },
        "native_block_cache_misses_per_read": { "type": "number", "minimum": 0 },
        "control_block_cache_misses_per_read": { "type": "number", "minimum": 0 },
        "native_physical_bytes_per_read": { "type": "number", "minimum": 0 },
        "control_physical_bytes_per_read": { "type": "number", "minimum": 0 },
        "native_physical_bytes_per_read_ratio": { "type": "number", "minimum": 0 },
        "native_read_amplification_ratio": { "type": "number", "minimum": 0 },
        "pressure_passed": { "type": "boolean" },
        "passed": { "type": "boolean" }
      }
    }
  }
}
