{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Doss-com/objectKV/evals/schema/t27-aggregate-run-receipt-v1.schema.json",
  "title": "objectKV T27 final aggregate receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workload_sha256",
    "runtime_source_sha256",
    "runtime_executable_sha256",
    "runtime_cargo_lock_sha256",
    "plan_sha256s",
    "stratum_ids",
    "stratum_plan_sha256s",
    "stratum_execution_sha256s",
    "stratum_receipt_sha256s",
    "total_positions",
    "started_at",
    "finished_at",
    "passed",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "workload_sha256": { "$ref": "#/$defs/sha256" },
    "runtime_source_sha256": { "$ref": "#/$defs/sha256" },
    "runtime_executable_sha256": { "$ref": "#/$defs/sha256" },
    "runtime_cargo_lock_sha256": { "$ref": "#/$defs/sha256" },
    "plan_sha256s": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/sha256" }
    },
    "stratum_ids": { "$ref": "#/$defs/strata" },
    "stratum_plan_sha256s": {
      "type": "array",
      "minItems": 27,
      "maxItems": 27,
      "items": { "$ref": "#/$defs/sha256" }
    },
    "stratum_execution_sha256s": {
      "type": "array",
      "minItems": 27,
      "maxItems": 27,
      "items": { "$ref": "#/$defs/sha256" }
    },
    "stratum_receipt_sha256s": {
      "type": "array",
      "minItems": 27,
      "maxItems": 27,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/sha256" }
    },
    "total_positions": { "const": 540 },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "passed": { "type": "boolean" },
    "receipt_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "strata": {
      "type": "array",
      "minItems": 27,
      "maxItems": 27,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^c[0-9]{2}-z[0-9]{2}-s[0-9]+$" }
    }
  }
}
