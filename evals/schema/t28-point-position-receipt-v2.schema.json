{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://objectkv.dev/evals/schema/t28-point-position-receipt-v2.schema.json",
  "title": "objectKV RFC-0046 T28 fresh-process point position receipt v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "plan_sha256", "subject", "trace_seed",
    "block_ordinal", "position_in_block", "concurrent_clients",
    "measured_operations", "warm_index_objects", "warm_provider_attempts",
    "warm_response_bytes", "measured_provider_attempts",
    "measured_response_bytes", "full_data_requests", "list_requests",
    "put_requests", "delete_requests", "correctness_anomalies",
    "operation_latency_samples", "latency_nanos", "p50_latency_nanos",
    "p95_latency_nanos", "p99_latency_nanos", "p999_latency_nanos",
    "provider_latency_nanos", "provider_p50_latency_nanos",
    "provider_p95_latency_nanos", "provider_p99_latency_nanos",
    "provider_p999_latency_nanos", "local_residual_nanos",
    "local_residual_p50_nanos", "local_residual_p95_nanos",
    "local_residual_p99_nanos", "local_residual_p999_nanos",
    "wall_elapsed_nanos", "machine_id", "linux_boot_id", "process_id",
    "linux_process_start_ticks", "measured_started_unix_nanos",
    "measured_finished_unix_nanos", "receipt_sha256"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "plan_sha256": { "$ref": "#/$defs/sha256" },
    "subject": { "enum": ["candidate", "raw_range_control"] },
    "trace_seed": { "type": "integer", "minimum": 1 },
    "block_ordinal": { "type": "integer", "minimum": 0 },
    "position_in_block": { "type": "integer", "minimum": 0, "maximum": 3 },
    "concurrent_clients": { "type": "integer", "minimum": 1 },
    "measured_operations": { "type": "integer", "minimum": 1 },
    "warm_index_objects": { "type": "integer", "minimum": 1 },
    "warm_provider_attempts": { "type": "integer", "minimum": 3 },
    "warm_response_bytes": { "type": "integer", "minimum": 1 },
    "measured_provider_attempts": { "type": "integer", "minimum": 1 },
    "measured_response_bytes": { "type": "integer", "minimum": 1 },
    "full_data_requests": { "const": 0 },
    "list_requests": { "const": 0 },
    "put_requests": { "const": 0 },
    "delete_requests": { "const": 0 },
    "correctness_anomalies": { "const": 0 },
    "operation_latency_samples": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/operation_sample" }
    },
    "latency_nanos": { "$ref": "#/$defs/samples" },
    "p50_latency_nanos": { "$ref": "#/$defs/positive" },
    "p95_latency_nanos": { "$ref": "#/$defs/positive" },
    "p99_latency_nanos": { "$ref": "#/$defs/positive" },
    "p999_latency_nanos": { "$ref": "#/$defs/positive" },
    "provider_latency_nanos": { "$ref": "#/$defs/samples" },
    "provider_p50_latency_nanos": { "$ref": "#/$defs/positive" },
    "provider_p95_latency_nanos": { "$ref": "#/$defs/positive" },
    "provider_p99_latency_nanos": { "$ref": "#/$defs/positive" },
    "provider_p999_latency_nanos": { "$ref": "#/$defs/positive" },
    "local_residual_nanos": { "$ref": "#/$defs/nonnegative_samples" },
    "local_residual_p50_nanos": { "$ref": "#/$defs/nonnegative" },
    "local_residual_p95_nanos": { "$ref": "#/$defs/nonnegative" },
    "local_residual_p99_nanos": { "$ref": "#/$defs/nonnegative" },
    "local_residual_p999_nanos": { "$ref": "#/$defs/nonnegative" },
    "wall_elapsed_nanos": { "$ref": "#/$defs/positive" },
    "machine_id": { "type": "string", "minLength": 1 },
    "linux_boot_id": { "type": "string", "minLength": 1 },
    "process_id": { "type": "integer", "minimum": 1 },
    "linux_process_start_ticks": { "type": "integer", "minimum": 1 },
    "measured_started_unix_nanos": { "$ref": "#/$defs/positive" },
    "measured_finished_unix_nanos": { "$ref": "#/$defs/positive" },
    "receipt_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "positive": { "type": "integer", "minimum": 1 },
    "nonnegative": { "type": "integer", "minimum": 0 },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/positive" }
    },
    "nonnegative_samples": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/nonnegative" }
    },
    "operation_sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal", "end_to_end_nanos", "provider_nanos",
        "local_residual_nanos"
      ],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 0 },
        "end_to_end_nanos": { "$ref": "#/$defs/positive" },
        "provider_nanos": { "$ref": "#/$defs/positive" },
        "local_residual_nanos": { "$ref": "#/$defs/nonnegative" }
      }
    }
  }
}
