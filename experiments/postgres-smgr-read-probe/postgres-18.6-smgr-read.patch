+static bool
+okv_relation_selected(RelFileLocator rlocator)
+{
+	const char *relation = getenv("OKV_SMGR_READ_RELATION");
+	const char *database = getenv("OKV_SMGR_READ_DATABASE");
+	const char *tablespace = getenv("OKV_SMGR_READ_TABLESPACE");
+
+	if (relation == NULL && database == NULL && tablespace == NULL)
+		return false;
+	if (relation == NULL || database == NULL || tablespace == NULL)
+		ereport(ERROR,
+				(errmsg("objectKV relation selection requires tablespace, database, and relation")));
+
+	return rlocator.relNumber == okv_env_u32("OKV_SMGR_READ_RELATION") &&
+		rlocator.dbOid == okv_env_u32("OKV_SMGR_READ_DATABASE") &&
+		rlocator.spcOid == okv_env_u32("OKV_SMGR_READ_TABLESPACE");
+}
+
+static uint32
+okvmaxcombine(SMgrRelation reln, ForkNumber forknum, BlockNumber blocknum)
+{
+	return Min(mdmaxcombine(reln, forknum, blocknum), 128U);
+}
+
+static void
+okvreadv(SMgrRelation reln, ForkNumber forknum, BlockNumber blocknum,
+		 void **buffers, BlockNumber nblocks)
+{
+	unsigned char request[OKV_REQUEST_HEADER_BYTES] = {0};
+	unsigned char response[OKV_RESPONSE_HEADER_BYTES];
+	uint32		status;
+	uint32		page_count;
+	uint32		payload_bytes;
+	uint64		objectkv_version;
+	uint64		maximum_page_lsn;
+	uint64		expected_payload;
+	int			socket_fd;
+
+	if (nblocks == 0 || nblocks > 128)
+		ereport(ERROR,
+				(errmsg("objectKV read block count %u is outside 1..128", nblocks)));
+
+	objectkv_version = okv_env_u64("OKV_SMGR_OBJECTKV_VERSION");
+	maximum_page_lsn = okv_env_u64("OKV_SMGR_MAX_PAGE_LSN");
+	memcpy(request, "OKVPG001", 8);
+	okv_put_u32(request, 8, reln->smgr_rlocator.locator.spcOid);
+	okv_put_u32(request, 12, reln->smgr_rlocator.locator.dbOid);
+	okv_put_u32(request, 16, reln->smgr_rlocator.locator.relNumber);
+	okv_put_u32(request, 20,
+				 reln->smgr_rlocator.backend == INVALID_PROC_NUMBER ? 0 :
+				 (uint32) reln->smgr_rlocator.backend);
+	okv_put_u32(request, 24, (uint32) forknum);
+	okv_put_u32(request, 28, blocknum);
+	okv_put_u32(request, 32, nblocks);
+	okv_put_u64(request, 36, objectkv_version);
+	okv_put_u64(request, 44, maximum_page_lsn);
+
+	socket_fd = okv_connect_page_service();
+	okv_write_all(socket_fd, request, sizeof(request));
+	okv_read_all(socket_fd, response, sizeof(response));
+	if (memcmp(response, "OKVPGR01", 8) != 0)
+	{
+		close(socket_fd);
+		ereport(ERROR,
+				(errmsg("objectKV page service returned invalid response magic")));
+	}
+	status = okv_get_u32(response, 8);
+	page_count = okv_get_u32(response, 12);
+	payload_bytes = okv_get_u32(response, 16);
+	if (status != 0)
+	{
+		char   *message;
+
+		if (payload_bytes > OKV_MAX_ERROR_BYTES)
+		{
+			close(socket_fd);
+			ereport(ERROR,
+					(errmsg("objectKV page service error exceeds protocol bound")));
+		}
+		message = palloc((Size) payload_bytes + 1);
+		okv_read_all(socket_fd, (unsigned char *) message, payload_bytes);
+		message[payload_bytes] = '\0';
+		close(socket_fd);
+		ereport(ERROR,
+				(errmsg("objectKV page read refused: %s", message)));
+	}
+	expected_payload = (uint64) nblocks * BLCKSZ;
+	if (page_count != nblocks || payload_bytes != expected_payload)
+	{
+		close(socket_fd);
+		ereport(ERROR,
+				(errmsg("objectKV page response shape mismatch: pages %u, bytes %u",
+						page_count, payload_bytes)));
+	}
+	for (BlockNumber block = 0; block < nblocks; block++)
+		okv_read_all(socket_fd, buffers[block], BLCKSZ);
+	close(socket_fd);
+	elog(LOG,
+		 "objectKV smgr_readv relation %u blocks %u..%u at objectKV version %llu and maximum page LSN %llu",
+		 reln->smgr_rlocator.locator.relNumber, blocknum,
+		 blocknum + nblocks - 1, (unsigned long long) objectkv_version,
+		 (unsigned long long) maximum_page_lsn);
+}
+
+static void
+okvstartreadv(PgAioHandle *ioh, SMgrRelation reln, ForkNumber forknum,
+			  BlockNumber blocknum, void **buffers, BlockNumber nblocks)
+{
+	okvreadv(reln, forknum, blocknum, buffers, nblocks);
+	pgaio_io_set_target_smgr(ioh, reln, forknum, blocknum, nblocks, false);
+	pgaio_io_complete_readv_synchronously(ioh, nblocks);
+}
+
+static uint64
+okv_env_u64(const char *name)
+{
+	const char *value = getenv(name);
+	char   *end = NULL;
+	unsigned long long parsed;
+
+	if (value == NULL || value[0] == '\0')
+		ereport(ERROR, (errmsg("objectKV setting %s is required", name)));
+	errno = 0;
+	parsed = strtoull(value, &end, 10);
+	if (errno != 0 || end == value || *end != '\0')
+		ereport(ERROR, (errmsg("objectKV setting %s is not an unsigned integer", name)));
+	return (uint64) parsed;
+}
+
+static uint32
+okv_env_u32(const char *name)
+{
+	uint64		value = okv_env_u64(name);
+
+	if (value > PG_UINT32_MAX)
+		ereport(ERROR, (errmsg("objectKV setting %s exceeds uint32", name)));
+	return (uint32) value;
+}
+
+static int
+okv_connect_page_service(void)
+{
+	const char *host = getenv("OKV_SMGR_PAGE_HOST");
+	const char *port = getenv("OKV_SMGR_PAGE_PORT");
+	struct addrinfo hints = {0};
+	struct addrinfo *addresses = NULL;
+	struct addrinfo *address;
+	struct timeval timeout = {.tv_sec = 5, .tv_usec = 0};
+	int			socket_fd = -1;
+	int			status;
+
+	if (host == NULL)
+		host = "127.0.0.1";
+	if (port == NULL || port[0] == '\0')
+		ereport(ERROR, (errmsg("objectKV setting OKV_SMGR_PAGE_PORT is required")));
+	hints.ai_family = AF_UNSPEC;
+	hints.ai_socktype = SOCK_STREAM;
+	status = getaddrinfo(host, port, &hints, &addresses);
+	if (status != 0)
+		ereport(ERROR,
+				(errmsg("could not resolve objectKV page service %s:%s: %s",
+						host, port, gai_strerror(status))));
+	for (address = addresses; address != NULL; address = address->ai_next)
+	{
+		socket_fd = socket(address->ai_family, address->ai_socktype,
+						   address->ai_protocol);
+		if (socket_fd < 0)
+			continue;
+		(void) setsockopt(socket_fd, SOL_SOCKET, SO_RCVTIMEO, &timeout,
+						  sizeof(timeout));
+		(void) setsockopt(socket_fd, SOL_SOCKET, SO_SNDTIMEO, &timeout,
+						  sizeof(timeout));
+		if (connect(socket_fd, address->ai_addr, address->ai_addrlen) == 0)
+			break;
+		close(socket_fd);
+		socket_fd = -1;
+	}
+	freeaddrinfo(addresses);
+	if (socket_fd < 0)
+		ereport(ERROR,
+				(errmsg("could not connect to objectKV page service %s:%s: %m",
+						host, port)));
+	return socket_fd;
+}
+
+static void
+okv_write_all(int socket_fd, const unsigned char *buffer, size_t length)
+{
+	while (length > 0)
+	{
+		ssize_t		written = write(socket_fd, buffer, length);
+
+		if (written < 0 && errno == EINTR)
+			continue;
+		if (written <= 0)
+		{
+			close(socket_fd);
+			ereport(ERROR, (errmsg("could not write objectKV page request: %m")));
+		}
+		buffer += written;
+		length -= written;
+	}
+}
+
+static void
+okv_read_all(int socket_fd, unsigned char *buffer, size_t length)
+{
+	while (length > 0)
+	{
+		ssize_t		read_bytes = read(socket_fd, buffer, length);
+
+		if (read_bytes < 0 && errno == EINTR)
+			continue;
+		if (read_bytes <= 0)
+		{
+			close(socket_fd);
+			ereport(ERROR, (errmsg("could not read objectKV page response: %m")));
+		}
+		buffer += read_bytes;
+		length -= read_bytes;
+	}
+}
+
+static void
+okv_put_u32(unsigned char *buffer, size_t offset, uint32 value)
+{
+	buffer[offset] = (unsigned char) (value >> 24);
+	buffer[offset + 1] = (unsigned char) (value >> 16);
+	buffer[offset + 2] = (unsigned char) (value >> 8);
+	buffer[offset + 3] = (unsigned char) value;
+}
+
+static void
+okv_put_u64(unsigned char *buffer, size_t offset, uint64 value)
+{
+	for (int byte = 7; byte >= 0; byte--)
+	{
+		buffer[offset + byte] = (unsigned char) value;
+		value >>= 8;
+	}
+}
+
+static uint32
+okv_get_u32(const unsigned char *buffer, size_t offset)
+{
+	return (uint32) buffer[offset] << 24 |
+		(uint32) buffer[offset + 1] << 16 |
+		(uint32) buffer[offset + 2] << 8 |
+		(uint32) buffer[offset + 3];
+}
