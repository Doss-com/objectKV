+/*
+ * Complete a read that a non-file storage manager already performed
+ * synchronously. The result is interpreted by the registered callback chain.
+ */
+void
+pgaio_io_complete_readv_synchronously(PgAioHandle *ioh, int result)
+{
+	Assert(ioh->state == PGAIO_HS_HANDED_OUT);
+	Assert(pgaio_my_backend->handed_out_io == ioh);
+	Assert(pgaio_io_has_target(ioh));
+	Assert(ioh->op == PGAIO_OP_INVALID);
+	Assert(!INTERRUPTS_CAN_BE_PROCESSED());
+
+	HOLD_INTERRUPTS();
+
+	ioh->op = PGAIO_OP_READV;
+	ioh->result = 0;
+	pgaio_io_update_state(ioh, PGAIO_HS_DEFINED);
+	pgaio_my_backend->handed_out_io = NULL;
+	pgaio_io_call_stage(ioh);
+	pgaio_io_update_state(ioh, PGAIO_HS_STAGED);
+	pgaio_io_prepare_submit(ioh);
+
+	START_CRIT_SECTION();
+	pgaio_io_process_completion(ioh, result);
+	END_CRIT_SECTION();
+
+	RESUME_INTERRUPTS();
+}
